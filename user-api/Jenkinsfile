        //             bat 'mvn clean install -DskipTests'
        //         }
        //     }
        // }
        // stage('Product Service - Test') {
        //     steps {
        //         dir('product-service') {
        //             bat 'mvn test'
        //         }
        //     }
        // }

        stage('Git Info') {
            steps {
                bat 'git branch -a'     // shows all branches
                bat 'git log --oneline -5'  // shows last 5 commits
            }
        }
    }
    post {
        success { echo 'Build successful!' }
        failure { echo 'Build failed!' }
    }
}
