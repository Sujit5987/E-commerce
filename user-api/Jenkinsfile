pipeline {
    agent any
    tools {
        maven 'maven-3.9'
        jdk 'JDK-21'
    }
    stages {
        stage('User API - Build') {
            steps {
                dir('user-api') {
                    bat 'mvn clean install -DskipTests'
                }
            }
        }
        stage('User API - Test') {
            steps {
                dir('user-api') {
                    bat 'mvn test'
                }
            }
        }

        // ─── Add new microservices below when ready ───

        // stage('Brand Service - Build') {
